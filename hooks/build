#!/usr/bin/env bash
#
# Local build entry point. CI does not use this; .github/workflows/build.yml
# runs .github/scripts/driver.sh directly on an Ubuntu runner with Docker.
#
# This wrapper computes the same environment driver.sh expects and
# execs it from the repo root, so a single source of truth drives
# both local and CI builds.

set -eo pipefail

: "${ARCH:=$(uname -m)}"
: "${VARIANT:=base}"

IMAGE="btwiuse/arch"
TARBALL_DIR="dist"
PKGDIR="${PKGDIR:-$HOME/.cache/pacman/pkg}"
export IMAGE TARBALL_DIR PKGDIR

bash "$(dirname "$0")/.github/scripts/driver.sh"