#!/usr/bin/env bash

echo "------ HOOK START - BUILD -------"

printenv

docker images

whoami

pwd

df -h

ls -la

git status

lscpu

lsblk

lsmod

mount

free -h

ifconfig -a

# sudo make rootfs

if ! which sudo; then
  apt install -y sudo || :
fi

sudo=sudo
if [[ $(whoami) = root ]]; then
  sudo=""
fi

$sudo modprobe ext4 || :

# docker pull index.docker.io/latestarch/linux:latest
$sudo docker pull ${IMAGE_NAME:-latestarch/linux} || :

if [[ -d /var/cache/pacman/pkg ]]; then
  $sudo docker run -v $PWD:$PWD -v $PWD/rootfs/etc/pacman.d/mirrorlist:/etc/pacman.d/mirrorlist -w $PWD -v /var/cache/pacman/pkg:/var/cache/pacman/pkg --privileged ${IMAGE_NAME:-latestarch/linux} make rootfs
else
  $sudo docker run -v $PWD:$PWD -v $PWD/rootfs/etc/pacman.d/mirrorlist:/etc/pacman.d/mirrorlist -w $PWD --privileged ${IMAGE_NAME:-latestarch/linux} cat /etc/pacman.d/mirrorlist
fi

$sudo docker build -t ${IMAGE_NAME:-latestarch/linux} .

echo "------ HOOK END - BUILD -------"
