#!/usr/bin/env bash

echo "------ HOOK START - BUILD -------"
printenv

apt install -y net-tools

docker images

whoami

pwd

df -h

ls -la

git status

lscpu

lsblk

mount

free -h

ifconfig -a

# sudo make rootfs

sudo modprobe ext4

if [[ -d /var/cache/pacman/pkg ]]; then
  sudo docker run -it -v $PWD:$PWD -w $PWD -v /var/cache/pacman/pkg:/var/cache/pacman/pkg --privileged ${IMAGE_NAME:-latestarch/linux} make rootfs
else
  sudo docker run -it -v $PWD:$PWD -w $PWD --privileged ${IMAGE_NAME:-latestarch/linux} make rootfs
fi

sudo docker build -t ${IMAGE_NAME:-latestarch/linux} .

echo "------ HOOK END - BUILD -------"
