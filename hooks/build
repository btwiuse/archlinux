#!/usr/bin/env bash

gather_info(){
  getenforce

  cat /proc/cmdline

  printenv

  docker images

  whoami

  pwd

  df -h

  ls -la

  git status

  lscpu

  lsblk

  lsmod

  mount

  free -h

  ifconfig -a
}

update_docker_image(){
  sudo=sudo
  if [[ $(whoami) = root ]]; then
    sudo=""
  fi

  if [[ -d /var/cache/pacman/pkg ]]; then
    PKGDIR=/var/cache/pacman/pkg
  fi

  $sudo docker \
  run \
  -v $PWD:$PWD \
  -v /var/run:/var/run \
  -v ${PKGDIR:-$PWD/cache}:/var/cache/pacman/pkg \
  -v $PWD/rootfs/etc/pacman.d/mirrorlist:/etc/pacman.d/mirrorlist \
  -w $PWD \
  --privileged \
  ${IMAGE_NAME:-latestarch/linux} \
  ./build
}

main(){
  echo "------ HOOK START - BUILD -------"
  gather_info
  update_docker_image
  echo "------ HOOK END - BUILD -------"
}

main "$@"
