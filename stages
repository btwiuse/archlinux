#!/usr/bin/env bash
#
# ./stages: legacy orchestrator kept for the historical ./docker-build
# flow (which launches a btwiuse/arch:docker-x86_64 container). All
# real logic now lives in .github/scripts/*.sh. This file is a thin
# shim that sets the environment driver.sh expects and execs it.
#
# If you are running ./stages directly on an Arch host or in CI,
# prefer .github/scripts/driver.sh, which is the source of truth.

set -eo pipefail

: "${ARCH:?set ARCH (e.g. x86_64, i686, aarch64, riscv64)}"
: "${VARIANT:=base}"
: "${PKGDIR:=/var/cache/pacman/pkg}"

IMAGE="btwiuse/arch"
TARBALL_DIR="dist"
export IMAGE TARBALL_DIR

exec bash "$(dirname "$0")/.github/scripts/driver.sh"