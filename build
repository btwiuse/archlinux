#!/usr/bin/env bash

main(){
TMPDIR=$(mktemp -d)

cp --recursive --preserve=timestamps --backup --suffix=.pacnew rootfs/* ${TMPDIR}/
env -i pacstrap -C /usr/share/devtools/pacman-extra.conf -c -d -G -M ${TMPDIR} $(cat packages)
test -d pkg || git clone https://github.com/latestarch-org/pkg
cp -v pkg/*.pkg.tar.xz ${TMPDIR}/root/
mount --bind ${TMPDIR} ${TMPDIR}
arch-chroot ${TMPDIR} locale-gen en_US.UTF-8

cat strap.sh | arch-chroot ${TMPDIR} bash

# TODO: try chpasswd
arch-chroot ${TMPDIR} bash -c 'useradd -U -ms /bin/bash star'
arch-chroot ${TMPDIR} bash -c 'passwd -d star'

for group in $(cat groups); do
  arch-chroot ${TMPDIR} bash -c "groupadd -f ${group}"
  arch-chroot ${TMPDIR} bash -c "usermod -a -G ${group} star"
done

arch-chroot ${TMPDIR} bash -c 'echo "%wheel ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers'

arch-chroot ${TMPDIR} bash -c 'ls -1 /root/ | grep .pkg.tar.xz | (cd /root; xargs pacman -U --noconfirm --force)'

# fakeroot is broken in docker, resort to pacman -U for now
# arch-chroot -u star ${TMPDIR} bash -c 'yaourt -Syu --noconfirm libselinux yay'
# arch-chroot ${TMPDIR} getenforce
arch-chroot ${TMPDIR} mkinitcpio -p linux
arch-chroot ${TMPDIR} pkgfile --update

umount ${TMPDIR}
tar --numeric-owner --xattrs --acls --exclude-from=exclude -C ${TMPDIR} -c . | docker import --change 'CMD ["/usr/bin/bash"]' --change 'ENV LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 TZ=Asia/Shanghai' - latestarch/linux:latest
rm -rf ${TMPDIR}
}

main "$@"
