#!/usr/bin/env bash
#
# Push per-arch images for a tag, then build the multi-arch manifest
# list and push it. Reads DOCKERHUB_USERNAME / DOCKERHUB_TOKEN from the
# environment, e.g.
#
#   DOCKERHUB_USERNAME=btwiuse \
#   DOCKERHUB_TOKEN=... \
#   ./push
#
# In CI this script is superseded by .github/workflows/build.yml's
# aggregate job, which produces the same set of tags and manifest
# lists automatically. This file is kept for ad-hoc local use and as
# the canonical reference for what the aggregate job publishes.

set -euo pipefail

: "${DOCKERHUB_USERNAME:?set DOCKERHUB_USERNAME}"
: "${DOCKERHUB_TOKEN:?set DOCKERHUB_TOKEN}"

# Feed the token via stdin so it never lands in argv / shell history.
printf '%s' "${DOCKERHUB_TOKEN}" | docker login -u "${DOCKERHUB_USERNAME}" --password-stdin

ARCHES=(x86_64 i686 aarch64 riscv64)

push_tag(){
  TAG="$1"
  TARGET="${2:-$TAG}"
  for a in "${ARCHES[@]}"; do
    docker push "btwiuse/arch:$TAG-$a"
  done

  amends=()
  annotates=()
  declare -A os_arch=( [x86_64]="amd64" [i686]="386" [aarch64]="arm64" [riscv64]="riscv64" )
  for a in "${ARCHES[@]}"; do
    amends+=( --amend "btwiuse/arch:$TAG-$a" )
  done
  docker manifest create "btwiuse/arch:$TARGET" "${amends[@]}"
  for a in "${ARCHES[@]}"; do
    args=( --os linux --arch "${os_arch[$a]}" )
    if [[ "$a" == aarch64 ]]; then args+=( --variant v8 ); fi
    docker manifest annotate "${args[@]}" "btwiuse/arch:$TARGET" "btwiuse/arch:$TAG-$a"
  done

  docker manifest push "btwiuse/arch:$TARGET"
}

push_tag bootstrap
push_tag base
push_tag base latest