#!/usr/bin/env bash

bootstrap(){
  pushd pkgs >/dev/null
  # bugs.archlinux.org/task/23608
  echo sed
  echo gzip
  cat archlinux-bootstrap-packages
  popd >/dev/null
}

base(){
  pushd pkgs/common >/dev/null
  cat base* base-devel dev keyring editor cmdline
  popd >/dev/null

  pushd pkgs/${ARCH} >/dev/null
  cat keyring
  popd >/dev/null
}

all(){
  pushd pkgs/common >/dev/null
  ls -1 | xargs cat
  popd >/dev/null

  pushd pkgs/${ARCH} >/dev/null
  cat *
  popd >/dev/null
}

common(){
  case $1 in
  bootstrap)
    bootstrap
  ;;
  base)
    base
  ;;
  *)
    all
  ;;
  esac
}

main(){
  if [[ -z $ARCH ]]; then ARCH=x86_64; fi
  common "$@"
}

main "$@" | grep -v '#' | grep .
